  "info": {
    "title": "InclusiveCare API",
    "description": "Successful responses are wrapped as `{ data }` (plus `meta` for lists). Errors are `{ error: { code, message, details } }`.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "locale": {
            "enum": [
              "fr",
              "en",
              "ar"
            ],
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "acceptTerms": {
            "type": "boolean"
          }
        },
        "required": [
          "email",
          "password",
          "firstName",
          "lastName",
          "acceptTerms"
        ]
      },
      "TokenDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "token"
        ]
      },
      "EmailDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "required": [
          "email"
        ]
      },
      "AccessibilityDto": {
        "type": "object",
        "properties": {
          "fontScale": {
            "enum": [
              100,
              112,
              125,
              150
            ],
            "type": "number"
          },
          "contrast": {
            "enum": [
              "default",
              "high"
            ],
            "type": "string"
          },
          "reducedMotion": {
            "type": "boolean"
          },
          "simplified": {
            "type": "boolean"
          }
        },
        "required": [
          "fontScale",
          "contrast",
          "reducedMotion",
          "simplified"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "locale": {
            "enum": [
              "fr",
              "en",
              "ar"
            ],
            "type": "string"
          },
          "status": {
            "enum": [
              "PENDING_VERIFICATION",
              "ACTIVE",
              "SUSPENDED",
              "DEACTIVATED"
            ],
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "USER",
                "MODERATOR",
                "ADMIN"
              ]
            }
          },
          "accessibility": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/AccessibilityDto"
              }
            ]
          },
          "lastLoginAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          },
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "locale",
          "status",
          "roles",
          "accessibility",
          "lastLoginAt",
          "id",
          "email",
          "firstName",
          "lastName",
          "createdAt"
        ]
      },
      "SessionDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number"
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "user"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 200
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "locale": {
            "enum": [
              "fr",
              "en",
              "ar"
            ],
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          }
        }
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "maxLength": 128
          },
          "newPassword": {
            "type": "string"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "DeleteAccountDto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "password"
        ]
      },
      "PageMetaDto": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number"
          },
          "pageSize": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "totalPages": {
            "type": "number"
          }
        },
        "required": [
          "page",
          "pageSize",
          "total",
          "totalPages"
        ]
      },
      "UpdateRolesDto": {
        "type": "object",
        "properties": {
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "USER",
                "MODERATOR",
                "ADMIN"
              ]
            }
          }
        },
        "required": [
          "roles"
        ]
      },
      "UpdateStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "ACTIVE",
              "SUSPENDED"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
}
