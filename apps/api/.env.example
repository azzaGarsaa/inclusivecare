NODE_ENV=development
PORT=3333

# PostgreSQL from docker-compose.yml (host port 5433)
DATABASE_URL=postgresql://inclusivecare:inclusivecare@localhost:5433/inclusivecare?schema=public

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-value-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Public URL of the Angular app, used in links sent by email
WEB_URL=http://localhost:4200

# Mailpit from docker-compose.yml. Inbox: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="InclusiveCare <no-reply@inclusivecare.local>"
