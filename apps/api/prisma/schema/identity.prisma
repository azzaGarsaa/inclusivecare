enum Role {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum Locale {
  fr
  en
  ar
}

enum OneTimeTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ConsentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  /// Always stored trimmed and lower-cased.
  email           String     @unique @db.VarChar(254)
  passwordHash    String     @map("password_hash")
  firstName       String     @map("first_name") @db.VarChar(80)
  lastName        String     @map("last_name") @db.VarChar(80)
  locale          Locale     @default(fr)
  status          UserStatus @default(PENDING_VERIFICATION)
  /// Display settings chosen in the accessibility panel (font scale, contrast…).
  accessibility   Json?
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz

  roles         UserRole[]
  refreshTokens RefreshToken[]
  oneTimeTokens OneTimeToken[]
  consents      Consent[]

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model UserRole {
  userId      String   @map("user_id") @db.Uuid
  role        Role
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz
  /// Null when the role was assigned by the system (registration, seed).
  grantedById String?  @map("granted_by_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

/// Refresh tokens rotate on every use. All tokens issued from one login share
/// a family; presenting an already-rotated token revokes the whole family.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  userAgent String?   @map("user_agent") @db.VarChar(300)
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model OneTimeToken {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @map("user_id") @db.Uuid
  purpose    OneTimeTokenPurpose
  tokenHash  String              @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime            @map("expires_at") @db.Timestamptz
  consumedAt DateTime?           @map("consumed_at") @db.Timestamptz
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("one_time_tokens")
}

model Consent {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  type      ConsentType
  /// Version of the document the user agreed to, e.g. "2026-11".
  version   String      @db.VarChar(20)
  grantedAt DateTime    @default(now()) @map("granted_at") @db.Timestamptz
  revokedAt DateTime?   @map("revoked_at") @db.Timestamptz
  ipAddress String?     @map("ip_address") @db.VarChar(45)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("consents")
}
